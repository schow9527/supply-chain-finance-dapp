    elementType: text
    bounds: [620, 205, 280, 220]
    content:
      fontSize: 12
      color: "$body"
      lineHeight: 1.75
      text: |
        <p>成员 1 · 智能合约与测试</p>
        <p>成员 2 · 后端与部署</p>
        <p>成员 3 · 前端与 Web3</p>
        <p>成员 4 · 研究与技术报告</p>
        <p>成员 5 · 架构图 / PPT / 手册</p>
        <p>成员 6 · 测试与演示视频</p>
  - elementId: qa
    elementType: text
    bounds: [70, 430, 300, 40]
    content:
      fontSize: 22
      bold: true
      color: "$accent"
      wrap: false
      text: Q & A
  - elementId: repo
    elementType: text
    bounds: [380, 440, 520, 20]
    content:
      style: "$small"
      align: [right, top]
      wrap: false
      text: github.com/schow9527/supply-chain-finance-dapp
