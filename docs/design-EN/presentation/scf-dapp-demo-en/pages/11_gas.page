pageType: content
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 34, 300, 18]
    content: {style: "$kicker", wrap: false, text: 10 · GAS OPTIMIZATION}
  - elementId: title
    elementType: text
    bounds: [60, 54, 840, 40]
    content:
      style: "$title"
      wrap: false
      text: Storage packing + fewer cross-contract calls cut main-line gas by 15-21%
  - elementId: rule
    elementType: line
    bounds: [60, 102, 840, 1]
    viewBox: [840, 1]
    points: "0,0 840,0"
    border: {style: solid, width: 1, color: "$line"}
  - elementId: gas-chart
    elementType: chart
    bounds: [60, 124, 520, 340]
    data:
      cols: [Function, Before, After]
      rows:
        - [submitInvoice, 219256, 173254]
        - [confirmInvoice, 150356, 124931]
        - [requestFinancing, 171930, 145491]
        - [acceptQuote, 160852, 131343]
        - [redeem, 66008, 64043]
    series:
      - type: bar
        name: Before
        encode: {x: Function, y: Before}
        fill: "#B9C2C9"
      - type: bar
        name: After
        encode: {x: Function, y: After}
        fill: "$accent"
    legend: {position: top, fontSize: 12}
    yAxis:
      label: {fontSize: 11, numberFormat: "#,##0"}
      gridLine: {style: solid, color: "#EEEFF1", width: 1}
    xAxis:
      label: {fontSize: 11}
      axisLine: {style: solid, color: "#C9CFD4", width: 1}
      gridLine: false
  - elementId: vline
    elementType: line
    bounds: [610, 130, 1, 320]
    viewBox: [1, 320]
    points: "0,0 0,320"
    border: {style: solid, width: 1, color: "$line"}
  - elementId: s1
    elementType: text
    bounds: [640, 140, 260, 70]
    content:
      text: |
        <p><span style="font-size:28px;color:$accent"><strong>-10.2%</strong></span></p>
        <p><span style="font-size:12px;color:$gray">Average gas across 18 functions (92,801 -> 83,326)</span></p>
  - elementId: s2
    elementType: text
    bounds: [640, 230, 260, 90]
    content:
      style: "$body"
      text: |
        <p><strong>How</strong>: storage slot packing (uint96 / uint64), receivable metadata stored directly on the token to skip cross-contract reads, leaner dedup mapping.</p>
  - elementId: s3
    elementType: text
    bounds: [640, 330, 260, 110]
    content:
      style: "$small"
      lineHeight: 1.6
      text: |
        <p>Source: contracts/docs/gas/, Foundry benchmarks, re-measured on Sepolia.</p>
        <p>Optimized contracts redeployed; addresses and ABIs synced to the frontend (commits 9d11af2 / d56bdc4).</p>
  - elementId: footer
    elementType: text
    bounds: [60, 508, 400, 18]
    content: {style: "$small", wrap: false, text: SC6113 · Supply Chain Finance DApp}
  - elementId: page-num
    elementType: text
    bounds: [880, 508, 40, 18]
    content: {style: "$small", align: [right, top], wrap: false, text: "11"}
