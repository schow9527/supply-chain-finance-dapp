# Runtime environment: development, testing, or production
APP_ENV=development
PORT=5000
SECRET_KEY=replace-with-a-long-random-secret

# Development may use SQLite. Production must use a PostgreSQL URL.
DATABASE_URL=sqlite:///scf_dapp.db

# Supply your own provider; never commit a real API key.
WEB3_PROVIDER_URI=https://eth-sepolia.example.invalid/v2/YOUR_API_KEY
CHAIN_ID=11155111

# Contract addresses and START_BLOCK default to contracts/deployments/11155111.json.
# Optional environment variables can override them when a new deployment is used.
SYNC_POLL_INTERVAL=5
BLOCK_CONFIRMATIONS=1
