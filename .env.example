# Runtime. Never commit real secrets or provider URLs.
APP_ENV=development
FLASK_ENV=development
PROCESS_ROLE=web
PORT=5000
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///scf_dapp.db

# Sepolia read-only provider and synchronization.
WEB3_PROVIDER_URI=https://eth-sepolia.example.invalid/YOUR_API_KEY
CHAIN_ID=11155111
SYNC_START_BLOCK=11868898
SYNC_POLL_INTERVAL=5
SYNC_BATCH_SIZE=500
BLOCK_CONFIRMATIONS=1
REORG_LOOKBACK=12
EVENT_SYNC_ENABLED=false

# Private PDF storage. Production Web uses render_disk or s3; Worker uses disabled.
STORAGE_BACKEND=local
RENDER_DISK_MOUNT_PATH=/opt/render/project/src/uploads
RENDER_DISK_MIN_FREE_BYTES=104857600
# Development uses this relative folder. Render overrides it with the absolute mount path.
UPLOAD_FOLDER=uploads
WEB_INSTANCE_COUNT=1

# Optional long-term S3-compatible production backend.
S3_ENDPOINT_URL=https://s3-compatible.example.invalid
S3_REGION=us-east-1
S3_BUCKET=replace-with-private-bucket
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_KEY_PREFIX=development
